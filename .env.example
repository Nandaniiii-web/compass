# Compass — Environment Variables
# Copy to .env and fill in your values

# === Required ===
NEBIUS_API_KEY=your_nebius_api_key_here
AUTH_TOKEN=generate_a_random_token_here

# === Database ===
DATABASE_URL=postgresql://compass:compass@localhost:5432/compass

# === Nebius Token Factory ===
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
ROUTER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
SKILL_MODEL=nvidia/nemotron-3-super-120b-a12b
SYNTHESIS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSION=768

# === Google Calendar OAuth (Optional) ===
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback
TOKEN_ENCRYPTION_KEY=compass_secure_local_dev_token_encryption_key_32bytes!

# === App ===
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

